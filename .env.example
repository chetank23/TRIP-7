# ==============================================================================
# BVC Trip — Supabase PostgreSQL & Vercel Blob Configuration Example
# ==============================================================================
# These variables are automatically injected by Vercel when connecting the
# Supabase integration to the 'trip' project, prefixed with 'BVC_'.
#
# DO NOT commit real secrets or production tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & API Configuration (Custom 'BVC_' Prefix)
# ------------------------------------------------------------------------------
# The Supabase project REST API endpoint URL
BVC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public anon key for browser Realtime live subscriptions (safe for client)
NEXT_PUBLIC_BVC_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# Alternative public publishable key if generated by Vercel integration
BVC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-side privileged secret key for database mutations (NEVER expose to client)
BVC_SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Legacy service role key (supported as fallback for server operations)
BVC_SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT secret for auth token verification
BVC_SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Direct non-pooling PostgreSQL connection string for migration / admin tasks
BVC_POSTGRES_URL_NON_POOLING="postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# Database owner username
BVC_POSTGRES_USER="postgres"

# Optional client-side Supabase URL override (mirrors BVC_SUPABASE_URL)
NEXT_PUBLIC_BVC_SUPABASE_URL="https://your-project-ref.supabase.co"

# ------------------------------------------------------------------------------
# 2. Vercel Blob Storage Configuration (For PDF booking receipts)
# ------------------------------------------------------------------------------
# In Vercel production: Automatically injected when Blob Store is connected.
# For local offline development, leave BLOB_STORAGE_MODE=local.
BLOB_STORAGE_MODE="local"

# Vercel Blob read/write token for live cloud storage of documents
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 3. Daily BVC Trip Web Push Notifications
# ------------------------------------------------------------------------------
# Generate a matching VAPID key pair and CRON_SECRET once with:
#   node scripts/generate-push-secrets.mjs
# Add the generated values to Vercel Environment Variables.
# Never commit real values to GitHub.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY="your-vapid-public-key"
WEB_PUSH_VAPID_PRIVATE_KEY="your-vapid-private-key"
WEB_PUSH_VAPID_SUBJECT="https://trip-7.vercel.app"
CRON_SECRET="your-long-random-cron-secret"
