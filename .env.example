# Vercel Blob Storage Configuration
# -------------------------------------------------------------
# Mode 1: Local Blob Environment (Default for offline/local testing)
# Requires ZERO cloud credentials. All state and PDFs persist locally in .local-blob/
BLOB_STORAGE_MODE=local

# Mode 2: Live Vercel Cloud Blob Store
# Set BLOB_STORAGE_MODE=cloud and provide your token to connect directly to Vercel Cloud:
# BLOB_STORAGE_MODE=cloud
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
